# Menged configuration. Every setting has a development default, so a local
# run needs none of this. For production, copy to .env and fill in.

# --- Server -----------------------------------------------------------------
PORT=8080
# development or production
ENVIRONMENT=production
LOG_LEVEL=info
APP_NAME=Menged
APP_TIMEZONE=Africa/Addis_Ababa
# The address people reach the app at. Used in SMS links; https:// makes
# cookies Secure. Required in production, and https:// there (the prod
# compose file sets it from DOMAIN).
PUBLIC_URL=https://menged.example.et
# Take client IPs from the last X-Forwarded-For entry, the one the proxy
# adds. Only behind a proxy that sets it (the prod compose file's Caddy does).
TRUST_PROXY=false
AUTO_MIGRATE=true

# Keys one-time codes and confirmation links. Generated into APP_SECRET_FILE
# on first start if unset; at least 32 characters if you set it.
# APP_SECRET=
APP_SECRET_FILE=keys/app_secret

# Enables /metrics for requests with "Authorization: Bearer <token>". With the
# monitoring profile, put the same value in deployments/prometheus/metrics_token.
METRICS_TOKEN=

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://logistics:logistics@localhost:5434/logistics?sslmode=disable
# Used by deployments/docker-compose.prod.yml, which sets the app's
# DATABASE_URL itself. The password is passed apart from it, so it may
# contain any character.
DOMAIN=menged.example.et
DB_PASSWORD=change-me

# --- Files (signatures and delivery photos) ---------------------------------
# local or s3
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# S3_BUCKET=
# S3_REGION=us-east-1
# Set for an S3-compatible store other than AWS.
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_USE_SSL=true

# --- Maps -------------------------------------------------------------------
# OpenStreetMap's tiles are for light use; a busy deployment should point at
# its own tile server or a paid provider.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# The satellite view on the maps. Esri's imagery needs an ArcGIS account for
# commercial use; point this at your own provider, or set it to "off".
# MAP_SATELLITE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# MAP_SATELLITE_ATTRIBUTION=Imagery &copy; Esri, Maxar, Earthstar Geographics

# --- Stand-in providers ------------------------------------------------------
# SMS, email and payments default to stand-ins ("mock"). The SMS and email
# ones print what they would send in the server's terminal: codes and links.
# The payment ones are pages of this server that play telebirr's checkout
# and CBE Birr. A production deployment refuses to start with any of them,
# or with SANDBOX_URL set, unless this is set, for a demo or staging site.
# ALLOW_MOCK_PROVIDERS=false

# --- SMS --------------------------------------------------------------------
# mock, twilio or ethiotelecom
SMS_PROVIDER=mock
# The number drivers text status codes to, shown in the driver app and in
# assignment messages. With the mock it defaults to 6060.
SMS_NUMBER=
# Shared secret for the provider's webhooks: texts from phones at
# /api/v1/sms/inbound and delivery reports at /api/v1/sms/status, with
# ?secret=... or the X-Webhook-Secret header. Required for them with a real
# provider.
SMS_INBOUND_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# ETHIO_TELECOM_API_URL=
# ETHIO_TELECOM_API_KEY=
# ETHIO_TELECOM_SENDER_ID=

# --- Email ------------------------------------------------------------------
# Password resets, address verification, invoices and receipts.
# mock or smtp
MAIL_PROVIDER=smtp
# Port 465 uses TLS from the start; others upgrade with STARTTLS.
SMTP_ADDR=smtp.example.et:587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to "<APP_NAME> <no-reply@<host of PUBLIC_URL>>".
# MAIL_FROM=Menged <no-reply@menged.example.et>

# --- Billing ----------------------------------------------------------------
# mock (telebirr and CBE Birr stand-ins), none (bank transfer, confirmed by
# the platform admin), or the providers offered: telebirr, cbebirr or
# telebirr,cbebirr. Defaults to none in production.
# PAYMENT_PROVIDER=none
#
# telebirr (H5 C2B web checkout), with the URLs and IDs telebirr issues at
# onboarding: the payer pays on telebirr's page, which
# notifies /api/v1/payments/telebirr/notify. The keys are files: the
# merchant's private key and telebirr's public key, PEM or the bare base64
# the merchant portal hands out. In production they go in
# deployments/secrets/, which the app sees at /run/secrets.
# TELEBIRR_API_URL=https://.../apiaccess/payment/gateway
# TELEBIRR_CHECKOUT_URL=https://.../payment/web/paygate?
# TELEBIRR_FABRIC_APP_ID=
# TELEBIRR_APP_SECRET=
# TELEBIRR_MERCHANT_APP_ID=
# TELEBIRR_MERCHANT_CODE=
# TELEBIRR_PRIVATE_KEY_FILE=/run/secrets/telebirr_private_key.pem
# TELEBIRR_PUBLIC_KEY_FILE=/run/secrets/telebirr_public_key.pem
#
# CBE Birr (pay by reference): the payer pays the merchant ID from their
# phone, quoting the invoice's reference, and CBE Birr's servers call
# /api/v1/payments/cbebirr/{query,validation,confirmation} with this login.
# With the mock, the login is derived from the app secret.
# CBEBIRR_MERCHANT_ID=
# CBEBIRR_CALLBACK_USERNAME=
# CBEBIRR_CALLBACK_PASSWORD=
#
# The provider sandbox's address, when the settings above (and the SMS
# gateway's) point at it: invoices link to its simulated phones. sandbox.env
# has every setting for the sandbox, and `make run-sandbox` reads it.
# SANDBOX_URL=http://localhost:8091
# Where companies send bank transfers, shown on every unpaid invoice. The
# platform admin marks the invoice paid when the money arrives. Required in
# production unless a payment provider is set.
BILLING_BANK_DETAILS=Commercial Bank of Ethiopia, account 1000123456789, Menged PLC
# Shown on invoices. Companies ask for help, and for an Enterprise offer,
# from the Help page in the dashboard. Defaults to support@<host of PUBLIC_URL>.
# SUPPORT_EMAIL=support@menged.example.et

# --- Data retention ---------------------------------------------------------
# Days a delivered or cancelled shipment keeps its customer's name, phone and
# addresses, the recipient's details, signatures and photos. After that they
# are removed and only what reports count stays. At least 30.
RETAIN_SHIPMENT_DAYS=365

# Verification codes (sign-up, PIN and password resets, track by phone) go to
# any number, so the platform texts at most this many in 24 hours; past it,
# code requests are refused and the monitoring alert fires at 80%. 0 turns
# the limit off.
OTP_DAILY_BUDGET=2000

# --- Monitoring profile -----------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Grafana emails its alerts (jobs failing or stopped, texts stuck in the
# outbox, server errors, a nearly full disk, verification codes running out)
# to this address, through SMTP_ADDR above and from GRAFANA_ALERT_FROM.
GRAFANA_ALERT_EMAIL=ops@menged.example.et
GRAFANA_ALERT_FROM=monitoring@menged.example.et
