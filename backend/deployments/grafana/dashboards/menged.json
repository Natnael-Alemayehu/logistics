                    },
                    {
                      "color": "orange",
                      "value": 4500
                    },
                    {
                      "color": "red",
                      "value": 11000
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
