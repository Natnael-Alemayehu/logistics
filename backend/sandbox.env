# The provider sandbox and Kiflet pointed at it. Both read this file (make
# sandbox, make run-sandbox, and the sandbox service in docker-compose.yml),
# so they agree on keys, logins and secrets. Nothing here is a secret: every
# value works with the sandbox only. The telebirr keys are throwaway pairs
# written by `make sandbox-keys` (on the first `make sandbox`).
#
# PORT is not set here: run both with the same one, e.g.
#   PORT=8090 make sandbox      and      PORT=8090 make run-sandbox

# --- SMS: Ethio telecom's gateway --------------------------------------------
SMS_PROVIDER=ethiotelecom
ETHIO_TELECOM_API_URL=http://localhost:8091/ethiotelecom
ETHIO_TELECOM_API_KEY=sandbox-ethio-telecom-key
ETHIO_TELECOM_SENDER_ID=KIFLET
SMS_NUMBER=6060
SMS_INBOUND_SECRET=sandbox-sms-webhook-secret

# --- Payments ----------------------------------------------------------------
PAYMENT_PROVIDER=telebirr,cbebirr

TELEBIRR_API_URL=http://localhost:8091/telebirr
TELEBIRR_CHECKOUT_URL=http://localhost:8091/telebirr/checkout?
TELEBIRR_FABRIC_APP_ID=sandbox-fabric-app
TELEBIRR_APP_SECRET=sandbox-telebirr-app-secret
TELEBIRR_MERCHANT_APP_ID=1100000000000001
TELEBIRR_MERCHANT_CODE=900001
TELEBIRR_PRIVATE_KEY_FILE=sandbox-keys/merchant_private.pem
TELEBIRR_PUBLIC_KEY_FILE=sandbox-keys/telebirr_public.pem

CBEBIRR_MERCHANT_ID=100100
CBEBIRR_CALLBACK_USERNAME=cbebirr
CBEBIRR_CALLBACK_PASSWORD=sandbox-cbebirr-password

# Invoices link to the sandbox's phones, and the health page names it.
SANDBOX_URL=http://localhost:8091
