# Where backups go off the machine, and who can read them. scripts/backup.sh
# reads this file as a shell script; copy it to backup.env, beside .env, and
# fill in. It is kept apart from .env so the app never sees the bucket's
# keys. docs/deploy.md, "Backups", has the rest.

# --- Encryption ---------------------------------------------------------------
# age public keys, separated by spaces. Each backup is encrypted to all of
# them, and any one of their private keys reads it. Make each pair on a
# machine of its own with `age-keygen -o kiflet-backup.key`, keep the private
# key off this server (a password manager, a USB stick in a safe), and put
# the public key here. Two keys held by two people means one lost key loses
# nothing.
BACKUP_AGE_RECIPIENTS="age1replacewiththefirstpublickey age1andthesecondone"

# --- The bucket ---------------------------------------------------------------
# Any S3-compatible store, with another provider than this machine's. Make
# the bucket with the provider's tools, private, with versioning or object
# lock if it has them, and give these keys the right to list, read and write
# it. A folder in a bucket works too: kiflet-backups/production.
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=kiflet-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Days the bucket keeps a backup: 90 if unset, 0 to keep them all (for a
# bucket whose own rules expire them).
# BACKUP_S3_KEEP_DAYS=90
