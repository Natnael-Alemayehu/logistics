.idea/
.vscode/
*.swp
*.swo
*~

# Keys
keys/
*.pem

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/

# Test coverage
coverage.html
coverage.out
# Signatures and delivery photos stored locally
uploads/

# The token Prometheus sends to /metrics: the same secret as METRICS_TOKEN
deployments/prometheus/metrics_token

# `go build ./cmd/server`
/server

# The provider sandbox's throwaway telebirr keys (make sandbox-keys)
/sandbox-keys/

# Provider keys for production, mounted at /run/secrets
deployments/secrets/*
