# Staging's backup.env (see backup.env.example): backups go to a second
# bucket in SeaweedFS. No age keys: the end-to-end test makes its own, as
# BACKUP_AGE_RECIPIENTS.
BACKUP_COMPOSE_FILE=deployments/docker-compose.backup.yml:deployments/staging/backup.yml
BACKUP_S3_ENDPOINT=http://s3:8333
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=kiflet-backups
BACKUP_S3_ACCESS_KEY=staging-access-key
BACKUP_S3_SECRET_KEY=staging-secret-key-0123456789
