# Server Configuration
PORT=8080
ENVIRONMENT=production
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgres://logistics:current_password@localhost:5432/logistics?sslmode=disable
DB_PASSWORD=current_password

# Redis Configuration
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000
JWT_ISSUER=logistics.et

# Storage Configuration
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# For S3 storage:
# STORAGE_TYPE=s3
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_USE_SSL=true

# SMS Configuration
SMS_PROVIDER=mock
# For Twilio:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# For Ethio Telecom:
# SMS_PROVIDER=ethiotelecom
# ETHIO_TELECOM_API_URL=
# ETHIO_TELECOM_API_KEY=
# ETHIO_TELECOM_SENDER_ID=

# Tracking URL (for SMS notifications and customer tracking)
# Use your domain or external IP address
# Examples: 
#   - With domain: TRACKING_URL_BASE=https://logistics.example.com
#   - With IP only: TRACKING_URL_BASE=http://35.192.45.100
TRACKING_URL_BASE=http://35.224.180.38

# Grafana Configuration (for monitoring profile)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=current_password
